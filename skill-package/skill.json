{
  "manifest": {
    "manifestVersion": "1.0",
    "publishingInformation": {
      "locales": {
        "en-AU": {
          "name": "My Car Tracker",
          "summary": "Private skill to track your car's rego, WOF and servicing.",
          "description": "Track New Zealand vehicle registration (rego), Warrant of Fitness (WOF), and service due dates. Ask what's coming up, set expiry dates, record a service with optional odometer, and optionally create Alexa reminders. Designed for private use on an Echo Show 15 (developer mode). Uses New Zealand English wording and Pacific/Auckland dates.",
          "examplePhrases": [
            "Alexa, open my car",
            "Alexa, ask my car when's the WOF due",
            "Alexa, ask my car what's coming up"
          ],
          "keywords": [
            "car",
            "rego",
            "registration",
            "WOF",
            "warrant",
            "service",
            "vehicle",
            "New Zealand"
          ]
        }
      },
      "isAvailableWorldwide": false,
      "testingInstructions": "Private developer skill for Shane Jenkins (NZ). Enable in Development stage. Test on Echo Show 15 with en-AU language. Grant Reminders permission when prompted. Sample: open my car; set the WOF due date to the first of June twenty twenty seven; what's coming up.",
      "category": "ORGANIZERS_AND_ASSISTANTS",
      "distributionCountries": [
        "AU",
        "NZ"
      ]
    },
    "privacyAndCompliance": {
      "allowsPurchases": false,
      "usesPersonalInfo": false,
      "isChildDirected": false,
      "isExportCompliant": true,
      "containsAds": false
    },
    "apis": {
      "custom": {
        "interfaces": [
          {
            "type": "ALEXA_PRESENTATION_APL",
            "supportedViewports": [
              {
                "mode": "HUB",
                "shape": "RECTANGLE",
                "minWidth": 1280,
                "maxWidth": 1920,
                "minHeight": 800,
                "maxHeight": 1080
              },
              {
                "mode": "HUB",
                "shape": "RECTANGLE",
                "minWidth": 1024,
                "maxWidth": 1279,
                "minHeight": 600,
                "maxHeight": 799
              },
              {
                "mode": "HUB",
                "shape": "RECTANGLE",
                "minWidth": 960,
                "maxWidth": 1279,
                "minHeight": 480,
                "maxHeight": 599
              },
              {
                "mode": "HUB",
                "shape": "ROUND",
                "minWidth": 480,
                "maxWidth": 480,
                "minHeight": 480,
                "maxHeight": 480
              }
            ]
          }
        ]
      }
    },
    "permissions": [
      {
        "name": "alexa::alerts:reminders:skill:readwrite"
      }
    ]
  }
}
