{
  "manifest": {
    "manifestVersion": "1.0",
    "publishingInformation": {
      "locales": {
        "en-AU": {
          "name": "My Car Tracker",
          "summary": "Private skill to track rego, WOF and servicing for Sarah's, Shane's and Cass's cars.",
          "description": "Track New Zealand vehicle registration (rego), Warrant of Fitness (WOF), and service due dates for Sarah's car, Shane's car, and Cass's car. Ask what's coming up across all three, set expiry dates per car, record a service with optional odometer, and optionally create Alexa reminders. Private use on an Echo Show 15 (developer mode). New Zealand English wording; Pacific/Auckland dates.",
          "examplePhrases": [
            "Alexa, open car due dates",
            "Alexa, ask car due dates when's the WOF due on Sarah's car",
            "Alexa, ask car due dates what's coming up"
          ],
          "keywords": [
            "car",
            "rego",
            "registration",
            "WOF",
            "warrant",
            "service",
            "vehicle",
            "New Zealand"
          ]
        }
      },
      "isAvailableWorldwide": false,
      "testingInstructions": "Private developer skill for Shane Jenkins (NZ). Three cars: Sarah's, Shane's, Cass's. Enable in Development. Test on Echo Show 15 with en-AU. Grant Reminders when prompted. Sample: open car due dates; set the WOF on Sarah's car to the first of June twenty twenty seven; what's coming up.",
      "category": "ORGANIZERS_AND_ASSISTANTS",
      "distributionCountries": [
        "AU",
        "NZ"
      ]
    },
    "privacyAndCompliance": {
      "allowsPurchases": false,
      "usesPersonalInfo": false,
      "isChildDirected": false,
      "isExportCompliant": true,
      "containsAds": false
    },
    "apis": {
      "custom": {
        "interfaces": [
          {
            "type": "ALEXA_PRESENTATION_APL",
            "supportedViewports": [
              {
                "mode": "HUB",
                "shape": "ROUND",
                "minWidth": 100,
                "maxWidth": 599,
                "minHeight": 100,
                "maxHeight": 599
              },
              {
                "mode": "HUB",
                "shape": "RECTANGLE",
                "minHeight": 100,
                "maxHeight": 599,
                "minWidth": 960,
                "maxWidth": 1279
              },
              {
                "mode": "HUB",
                "shape": "RECTANGLE",
                "minHeight": 600,
                "maxHeight": 959,
                "minWidth": 960,
                "maxWidth": 1279
              },
              {
                "mode": "HUB",
                "shape": "RECTANGLE",
                "minHeight": 600,
                "maxHeight": 1279,
                "minWidth": 1280,
                "maxWidth": 1920
              },
              {
                "mode": "HUB",
                "shape": "RECTANGLE",
                "minHeight": 960,
                "maxHeight": 1279,
                "minWidth": 1920,
                "maxWidth": 2560
              }
            ]
          },
          {
            "type": "ALEXA_DATASTORE_PACKAGEMANAGER",
            "packages": [
              {
                "id": "CarDueDatesWidget"
              }
            ]
          },
          {
            "type": "ALEXA_DATA_STORE"
          },
          {
            "type": "ALEXA_EXTENSION",
            "requestedExtensions": [
              {
                "uri": "alexaext:datastore:10"
              }
            ]
          }
        ]
      }
    },
    "permissions": [
      {
        "name": "alexa::alerts:reminders:skill:readwrite"
      }
    ]
  }
}
